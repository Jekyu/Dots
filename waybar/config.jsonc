// -*- mode: jsonc -*-
{
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "custom/power",
        "clock",
        "tray",
        "sway/mode",
    ],
    "modules-center": [
        "sway/workspaces",
    ],
    "modules-right": [
        "network",
        "cpu",
        "memory",
        "disk",
        "pulseaudio",
        "battery",
    ],
     "sway/workspaces": {
         "disable-scroll": true,
         "all-outputs": true,
         "warp-on-scroll": false,
         "format-icons": {
             "urgent": ""
             //"focused": "",
             //"default": ""
         }
     },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "tray": {
         "icon-size": 20
    },
    "clock": {
        // "timezone": "America/New_York",
        "format": " {:%a %d  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "format-alt": " {:%H:%M}",
    },
        "cpu": {
        "format": " {usage}",
        "tooltip": false
    },
    "memory": {
        "format": " {}"
    },
   "disk": {
    "format": " {free}",
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{essid}  {signalStrength}%",
        "format-ethernet": "󰈀",
        // "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname}: {gwaddr} 󰈀",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "⚠ 󰈂 󰤫",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume} {icon} {format_source}",
        "format-bluetooth": "{volume}%{icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": "   ",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "headphone": ["", "","󰕾", " "],
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "/usr/share/waybar/custom_modules/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    },
    "custom/power": {
      "format" : "󰣇 ",
      "on-click": "rofi -show",
		  "tooltip": false,
      "on-click-right": "~/.config/rofi/scripts/pm.sh"
		  /*"menu-file": "/usr/share/waybar/custom_modules/power_menu.xml", // Menu file in resources folder
		  "menu": "on-click",
		  "menu-actions": {
			  "shutdown": "systemctl poweroff",
			  "reboot": "systemctl reboot",
			  "suspend": "systemctl suspend",
			  "hibernate": "systemctl hibernate"
		}*/
    },
    "battery": {
	"interval": 60,
	"format": "{capacity}% {icon}",
	"format-icons": {
		"default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
		"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
	}
}
}
